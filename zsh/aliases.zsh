# ~/.config/zsh/aliases.zsh

# Fastfetch
alias ff="fastfetch"

# File tools
alias ls='elx'
alias la='elx -la'
alias ll='elx -l'
alias tree='elx --tree'

# Navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# Package management
alias i='sudo pacman -S'

# Zoxide
alias zi='zoxide query -i'
