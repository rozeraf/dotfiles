
// ============================================================
// NIRI + NOCTALIA
// ============================================================


// ------------------------------------------------------------
// INPUT
// ------------------------------------------------------------

input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:caps_toggle"
        }

        // Delay before held key starts repeating, ms.
        repeat-delay 300

        // Repeats per second.
        repeat-rate 50
    }

    touchpad {
        tap
        dwt
        natural-scroll
    }

    mouse {
        // Linear / no pointer acceleration.
        accel-profile "flat"

        // Lower sensitivity.
        // Valid range: -1.0 .. 1.0
        accel-speed -0.35
    }
}


// ------------------------------------------------------------
// STARTUP
// ------------------------------------------------------------

spawn-at-startup "noctalia"


// ------------------------------------------------------------
// GENERAL
// ------------------------------------------------------------

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot_%Y-%m-%d_%H-%M-%S.png"

cursor {
    hide-when-typing
    hide-after-inactive-ms 3000
}


// ------------------------------------------------------------
// LAYOUT
// ------------------------------------------------------------

layout {
    gaps 12

    center-focused-column "on-overflow"
    always-center-single-column

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width {
        proportion 0.5
    }

    focus-ring {
        on
        width 2

        active-color "#89b4fa"
        inactive-color "#45475a"
        urgent-color "#f38ba8"
    }

    border {
        off
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#00000050"
    }

    insert-hint {
        color "#89b4fa80"
    }
}


// ------------------------------------------------------------
// WINDOW APPEARANCE
// ------------------------------------------------------------

// Common appearance for normal windows.
//
// draw-border-with-background=false is important for transparent
// windows: otherwise the focus ring is drawn as a solid rectangle
// behind the window and can visually kill the blur when focused.
window-rule {
    geometry-corner-radius 14
    clip-to-geometry true
    draw-border-with-background false
}
window-rule {
    match app-id="^neovide$"

    background-effect {
        blur true
    }
}

// ------------------------------------------------------------
// GHOSTTY
// ------------------------------------------------------------

window-rule {
    match app-id=r#"^com\.mitchellh\.ghostty$"#

    background-effect {
        blur true
    }
}


// ------------------------------------------------------------
// ZED
// ------------------------------------------------------------

// Matches:
//   dev.zed.Zed
//   dev.zed.Zed-Preview
//   dev.zed.Zed-Nightly
//   dev.zed.Zed-Dev
window-rule {
    match app-id=r#"^dev\.zed\.Zed(-Preview|-Nightly|-Dev)?$"#

    background-effect {
        blur true
    }
}


// ------------------------------------------------------------
// NOCTALIA SETTINGS
// ------------------------------------------------------------

window-rule {
    match app-id="dev.noctalia.Noctalia"

    open-floating true

    default-column-width {
        fixed 1080
    }

    default-window-height {
        fixed 920
    }
}


// ------------------------------------------------------------
// ZEN BROWSER
// ------------------------------------------------------------

window-rule {
    match app-id=r#"^zen$"#

    // Same mode as Mod+F: maximized to the working-area edges,
    // without gaps or covering the bar.
    open-maximized true
}


// ------------------------------------------------------------
// NOCTALIA WALLPAPER / NIRI OVERVIEW
// ------------------------------------------------------------

layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}


// ------------------------------------------------------------
// BLUR
// ------------------------------------------------------------

blur {
    passes 3
    offset 3
    noise 0.02
    saturation 1.5
}


// Noctalia surfaces use regular/non-xray blur.
layer-rule {
    match namespace=r#"^noctalia-(bar-[^"]+|notification|dock|panel|attached-panel|osd)$"#

    background-effect {
        xray false
    }
}


// Noctalia window switcher.
layer-rule {
    match namespace="^noctalia-window-switcher$"

    background-effect {
        blur true
        xray false
    }
}


// ------------------------------------------------------------
// OVERVIEW
// ------------------------------------------------------------

overview {
    zoom 0.5

    workspace-shadow {
        softness 30
        spread 5
        offset x=0 y=5
        color "#00000050"
    }
}


// ------------------------------------------------------------
// ANIMATIONS
// ------------------------------------------------------------

animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    window-open {
        duration-ms 150
        curve "ease-out-expo"
    }

    window-close {
        duration-ms 120
        curve "ease-out-quad"
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    overview-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
}


// ------------------------------------------------------------
// KEYBINDS
// ------------------------------------------------------------

binds {

    // -------------------------
    // Applications
    // -------------------------

    Mod+Return {
        spawn "ghostty"
    }


    Mod+E {
        spawn "ghostty" "-e" "yazi";
    }

    Mod+W {
        spawn "zen-browser"
    }

    // Noctalia launcher
    Mod+D {
        spawn-sh "noctalia msg panel-toggle launcher"
    }

    // Noctalia control center
    Mod+S {
        spawn-sh "noctalia msg panel-toggle control-center"
    }

Super+V {
    spawn "noctalia" "msg" "panel-toggle" "clipboard";
}

    // Noctalia settings
    Mod+Comma {
        spawn-sh "noctalia msg settings-toggle"
    }

    // Noctalia window switcher
    Alt+Tab {
        spawn-sh "noctalia msg window-switcher"
    }


    // -------------------------
    // Niri overview
    // -------------------------

    Mod+O repeat=false {
        toggle-overview
    }


    // -------------------------
    // Window focus
    // -------------------------

    Mod+H {
        focus-column-left
    }

    Mod+L {
        focus-column-right
    }

    Mod+J {
        focus-window-down
    }

    Mod+K {
        focus-window-up
    }

    Mod+Left {
        focus-column-left
    }

    Mod+Right {
        focus-column-right
    }

    Mod+Down {
        focus-window-down
    }

    Mod+Up {
        focus-window-up
    }


    // -------------------------
    // Move windows
    // -------------------------

    Mod+Ctrl+H {
        move-column-left
    }

    Mod+Ctrl+L {
        move-column-right
    }

    Mod+Ctrl+J {
        move-window-down
    }

    Mod+Ctrl+K {
        move-window-up
    }


    // -------------------------
    // Workspaces
    // -------------------------

    Mod+U {
        focus-workspace-down
    }

    Mod+I {
        focus-workspace-up
    }

    Mod+Ctrl+U {
        move-column-to-workspace-down
    }

    Mod+Ctrl+I {
        move-column-to-workspace-up
    }


    // Direct workspace access

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }


    // Move column to workspace

    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }


    // -------------------------
    // Window sizing
    // -------------------------

    Mod+R {
        switch-preset-column-width
    }

    Mod+Shift+R {
        switch-preset-column-width-back
    }

    Mod+M {
        maximize-column
    }

    // Maximize to the working-area edges: no gaps, bar stays visible.
    Mod+F {
        maximize-window-to-edges
    }

    Mod+C {
        center-column
    }

    Mod+Shift+F {
        fullscreen-window
    }

    Mod+V {
        toggle-window-floating
    }


    // -------------------------
    // Close
    // -------------------------

    Mod+Q repeat=false {
        close-window
    }


    // -------------------------
    // Screenshots
    // -------------------------

    Print {
        screenshot
    }

    Alt+Print {
        screenshot-window
    }

    Ctrl+Print {
        screenshot-screen
    }


    // -------------------------
    // Volume — Noctalia
    // -------------------------

    XF86AudioRaiseVolume {
        spawn-sh "noctalia msg volume-up 2%"
    }

    XF86AudioLowerVolume {
        spawn-sh "noctalia msg volume-down 2%"
    }

    XF86AudioMute {
        spawn-sh "noctalia msg volume-mute"
    }


    // -------------------------
    // Brightness — Noctalia
    // -------------------------

    XF86MonBrightnessUp {
        spawn-sh "noctalia msg brightness-up"
    }

    XF86MonBrightnessDown {
        spawn-sh "noctalia msg brightness-down"
    }
}


// ------------------------------------------------------------
// NOCTALIA NOTIFICATION ACTION FIX
// ------------------------------------------------------------

debug {
    honor-xdg-activation-with-invalid-serial
}







include "noctalia.kdl"
