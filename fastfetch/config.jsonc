{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": "",
    "color": {
      "keys": "#cbbeff",
      "title": "#cac3dc"
    },
    "percent": {
      "color": {
        "green": "#eeb8cb",
        "yellow": "#cbbeff",
        "red": "#ffb4ab"
      }
    }
  },
  "logo": {
    "type": "none",
    "position": "top",
    "padding": {
      "top": 1,
      "bottom": 0,
      "left": 0,
      "right": 0
    },
    "color": {
      "1": "#cb63ff",
      "2": "#ca63dc"
    }
  },
  "modules": [
    {
      "type": "command",
      "key": " ",
      "text": "wallfetch render",
      "format": "{result}"
    },
    {
      "type": "title",
      "format": "{##e7b4ff}{user-name}@{host-name}{#}"
    },
    {
      "type": "custom",
      "key": "├─ ",
      "keyColor": "cyan",
      "outputColor": "cyan",
      "format": "system/"
    },
    {
      "type": "os",
      "key": "│  ├─ 󰣇  ",
      "keyColor": "cyan",
      "format": "{name} {##919191}{arch}{#}"
    },
    {
      "type": "kernel",
      "key": "│  ├─ 󰒓  ",
      "keyColor": "cyan",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "│  └─ 󰅐  ",
      "keyColor": "cyan",
      "format": "{formatted}"
    },
    {
      "type": "custom",
      "key": "├─ ",
      "keyColor": "blue",
      "outputColor": "blue",
      "format": "desktop/"
    },
    {
      "type": "command",
      "key": "│  └─ 󰇄  ",
      "keyColor": "blue",
      "text": "DESKTOP_STACK_CACHE_TTL=30 desktop-stack",
      "format": "{result}"
    },
    {
      "type": "custom",
      "key": "├─ ",
      "keyColor": "magenta",
      "outputColor": "magenta",
      "format": "shell/"
    },
    {
      "type": "terminal",
      "key": "│  ├─ 󰄛  ",
      "keyColor": "magenta",
      "format": "{pretty-name} {##919191}{version}{#}"
    },
    {
      "type": "shell",
      "key": "│  └─   ",
      "keyColor": "magenta",
      "format": "{pretty-name} {##919191}{version}{#}"
    },
    {
      "type": "custom",
      "key": "├─ ",
      "keyColor": "yellow",
      "outputColor": "yellow",
      "format": "hardware/"
    },
    {
      "type": "cpu",
      "key": "│  ├─   ",
      "keyColor": "yellow",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "│  ├─ 󰢮  ",
      "keyColor": "yellow",
      "driverSpecific": true,
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "│  └─   ",
      "keyColor": "yellow",
      "format": "{used} / {total} {##919191}({percentage}){#}"
    },
    {
      "type": "custom",
      "key": "├─ ",
      "keyColor": "green",
      "outputColor": "green",
      "format": "storage/"
    },
    {
      "type": "disk",
      "key": "│  └─   ",
      "keyColor": "green",
      "format": "{mountpoint} {size-used} / {size-total} {##919191}({size-percentage}){#}"
    },
    {
      "type": "custom",
      "key": "└─ ",
      "keyColor": "blue",
      "outputColor": "blue",
      "format": "network/"
    },
    {
      "type": "localip",
      "key": "   ├─ 󰩟  ",
      "keyColor": "blue",
      "showIpv4": true,
      "showIpv6": false,
      "showPrefixLen": false,
      "defaultRouteOnly": true,
      "format": "{ipv4}"
    },
    {
      "type": "localip",
      "key": "   └─ 󰖩  ",
      "keyColor": "blue",
      "showIpv4": true,
      "showIpv6": false,
      "showPrefixLen": false,
      "defaultRouteOnly": false,
      "namePrefix": "tailscale",
      "format": "{ipv4}"
    }
  ]
}
